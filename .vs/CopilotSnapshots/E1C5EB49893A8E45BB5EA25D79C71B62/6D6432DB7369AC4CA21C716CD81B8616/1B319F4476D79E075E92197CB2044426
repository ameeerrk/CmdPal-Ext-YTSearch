using Microsoft.CommandPalette.Extensions;
using Microsoft.CommandPalette.Extensions.Toolkit;
using System;
using System.Collections.Generic;

namespace ytSearch;

internal sealed partial class ytSearchPage : DynamicListPage
{
    private readonly List<IListItem> _items;

    public ytSearchPage()
    {
        Icon = IconHelpers.FromRelativePath("Assets\\StoreLogo.png");
        Title = "YouTube";
        Name = "Open";
        _items = new List<IListItem>();
    }

    public override IListItem[] GetItems()
    {
        return _items.ToArray();
    }

    public override void UpdateSearchText(string oldSearch, string query)
    {
        _items.Clear();

        if (!string.IsNullOrWhiteSpace(query))
        {
            var encodedQuery = Uri.EscapeDataString(query);
            var searchUrl = $"https://www.youtube.com/results?search_query={encodedQuery}";

            var command = new OpenUrlCommand(searchUrl, dismissOnInvoke: true);
            _items.Add(new ListItem(command)
            {
                Title = $"Search in YouTube"
            });
        }

        RaiseItemsChanged(0);
    }
}